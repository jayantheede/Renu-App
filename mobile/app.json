{
  "expo": {
    "name": "ReNu-Biome",
    "slug": "renu-biome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/renu-biome-app-icon-1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0C6054",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.renubiome.app",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "package": "com.renubiome.portal",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0C6054",
        "foregroundImage": "./assets/brand/renu-biome-app-icon-512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/renu-biome-app-icon-64.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ]
  }
}
