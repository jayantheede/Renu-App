generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model ApplicationLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId      String // Maps to Shopify Customer ID
  productName     String // Green Nitrogen, Peptide Nutrition, etc.
  fieldSite       String // User's custom field name
  applicationDate DateTime
  quantityDosage  Float
  acreageCovered  Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OtpRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         String   @default("Grower") // Grower, Ranch Manager, Owner, CEO, CTO, Support Administrator, Super Administrator
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Company {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  settings  String? // JSON for business settings
  entities  Entity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Entity {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId String?   @db.ObjectId
  company   Company?  @relation(fields: [companyId], references: [id])
  name      String
  sub       String?
  bal       Float     @default(0)
  ranches   Ranch[]
  invoices  Invoice[]
}

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId      String   @db.ObjectId
  action       String // e.g. "USER_CREATED", "ORDER_APPROVED"
  resourceType String // e.g. "Order", "User"
  resourceId   String?  @db.ObjectId
  details      String? // JSON payload of changes
  ipAddress    String?
  createdAt    DateTime @default(now())
}

model Ranch {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  entId          String      @db.ObjectId
  entity         Entity      @relation(fields: [entId], references: [id])
  name           String
  county         String
  ac             Float
  approvalStatus String      @default("APPROVED") // PENDING, APPROVED, REJECTED
  blocks         Block[]
  fields         Field[]
  tankSetups     TankSetup[]
}

model TankSetup {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  ranchId        String   @db.ObjectId
  ranch          Ranch    @relation(fields: [ranchId], references: [id])
  capacity       Float
  location       String?
  approvalStatus String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Block {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  ranchId String @db.ObjectId
  ranch   Ranch  @relation(fields: [ranchId], references: [id])
  name    String // e.g. "N-4"
  crop    String
  var     String
  ac      Float
  yr      Int
  set     Int
}

model Invoice {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String    @unique // e.g., "INV-10482"
  orderId       String?   @db.ObjectId
  entId         String    @db.ObjectId
  entity        Entity    @relation(fields: [entId], references: [id])
  status        String    @default("Draft") // Draft, Issued, Partially Paid, Paid, Overdue, Cancelled, Refunded
  issueDate     DateTime  @default(now())
  dueDate       DateTime
  subtotal      Float     @default(0)
  tax           Float     @default(0)
  totalAmount   Float     @default(0)
  amountPaid    Float     @default(0)
  balanceDue    Float     @default(0)
  pdfUrl        String?
  payments      Payment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Payment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId      String   @db.ObjectId
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  provider       String // e.g., "razorpay"
  transactionId  String?  @unique
  amount         Float
  currency       String   @default("INR")
  status         String   @default("Pending") // Pending, Success, Failed, Cancelled, Refunded
  receiptUrl     String?
  idempotencyKey String?  @unique
  webhookPayload String? // Store raw or stringified JSON of the webhook for audit
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Product {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  sku           String?             @unique
  name          String
  description   String
  price         Float
  imageUrl      String?
  units         String? // e.g., 'gal', 'lbs', 'liters'
  packageSize   Float?
  active        Boolean             @default(true)
  stockLevel    Float               @default(0)
  reservedStock Float               @default(0) // Prevent overselling
  reorderLevel  Float?
  warehouse     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  orderItems    OrderItem[]
  movements     InventoryMovement[]
}

model InventoryMovement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id])
  type        String // "adjustment", "reservation", "release", "fulfillment"
  quantity    Float
  reason      String?
  performedBy String?  @db.ObjectId // User ID
  createdAt   DateTime @default(now())
}

model PurchaseRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ranchId     String?  @db.ObjectId
  requesterId String   @db.ObjectId
  status      String   @default("pending") // pending, approved, rejected, fulfilled
  items       String // JSON payload of requested items
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String          @unique // Formatted like "ORD-1028"
  status          String          @default("Draft") // Draft, Submitted, Pending Approval, Approved, Processing, Partially Fulfilled, Shipped, Delivered, Rejected, Cancelled
  growerId        String?         @db.ObjectId
  ranchId         String?         @db.ObjectId
  subtotal        Float           @default(0)
  tax             Float           @default(0)
  discount        Float           @default(0)
  totalAmount     Float           @default(0)
  deliveryDetails String?
  customerEmail   String?
  items           OrderItem[]
  approvals       OrderApproval[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id])
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
  total     Float
}

model OrderApproval {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id])
  actorId   String   @db.ObjectId
  decision  String // Approved, Rejected, Modification Requested
  comments  String?
  timestamp DateTime @default(now())
}

model Conversation {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  participants String[]  @db.ObjectId // Array of User IDs
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @db.ObjectId
  content        String
  attachments    String[] // Array of URLs
  readBy         String[]     @db.ObjectId // User IDs who have read this
  createdAt      DateTime     @default(now())
}

model SupportTicket {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketNumber String   @unique // e.g. "TKT-1029"
  creatorId    String   @db.ObjectId
  assigneeId   String?  @db.ObjectId
  subject      String
  description  String
  status       String   @default("Open") // Open, In Progress, Escalated, Resolved, Closed
  priority     String   @default("Medium") // Low, Medium, High, Urgent
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  title        String
  body         String
  read         Boolean  @default(false)
  linkTarget   String? // Frontend route to navigate to
  resourceId   String? // Associated orderId, invoiceId, etc.
  resourceType String? // "Order", "Invoice", "Recommendation", etc.
  createdAt    DateTime @default(now())
}

model Field {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  ranchId    String     @db.ObjectId
  ranch      Ranch      @relation(fields: [ranchId], references: [id])
  name       String
  acreage    Float
  soilInfo   String?
  location   String?
  crops      Crop[]
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Crop {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  fieldId         String    @db.ObjectId
  field           Field     @relation(fields: [fieldId], references: [id])
  cropType        String
  variety         String
  plantingDate    DateTime?
  expectedHarvest DateTime?
  devStage        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Activity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fieldId   String   @db.ObjectId
  field     Field    @relation(fields: [fieldId], references: [id])
  type      String // irrigation, soil testing, fertilizer, inspection
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
}

model Recommendation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  state         String   @default("draft") // draft, submitted, reviewing, accepted, rejected, changes_requested, assigned, executed, completed, archived
  title         String
  product       String?
  quantity      Float?
  instructions  String?
  targetField   String?
  authorId      String?  @db.ObjectId
  reviewerId    String?  @db.ObjectId
  dates         String?
  comments      String?
  statusHistory String[] // Or a separate model for full history
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AppDataStore {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  payload   String
  updatedAt DateTime @updatedAt
}
