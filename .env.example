# ==========================================
# RENDER BACKEND WEB SERVICE ENVIRONMENT VARIABLES (TEMPLATE ONLY)
# Never commit real credentials to this file or source control!
# ==========================================
NODE_ENV=production
PORT=3000
DATABASE_URL="mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?appName=<APP_NAME>"
JWT_SECRET="<GENERATE_RANDOM_LONG_SECRET_KEY>"

# Gmail SMTP Email & MFA Verification
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="<OFFICE_EMAIL_ADDRESS>"
SMTP_PASS="<GMAIL_APP_PASSWORD>"

# OptimoRoute Dispatch & Delivery Sync
OPTIMOROUTE_BASE_URL="https://api.optimoroute.com/v1"
OPTIMOROUTE_EMAIL="<OPTIMOROUTE_LOGIN_EMAIL>"
OPTIMOROUTE_PASSWORD="<OPTIMOROUTE_LOGIN_PASSWORD>"
OPTIMOROUTE_API_KEY="<OPTIMOROUTE_API_KEY>"

# Otodata Cellular Tank Telemetry
OTODATA_BASE_URL="https://telematics.otodatanetwork.com:4431/v1.0/DataService.svc"
OTODATA_CID="<OTODATA_CID>"
OTODATA_USERNAME="<OTODATA_USERNAME>"
OTODATA_PASSWORD="<OTODATA_PASSWORD>"
OTODATA_API_KEY="<OTODATA_API_KEY>"

# ==========================================
# MOBILE APP (.env)
# ==========================================
EXPO_PUBLIC_API_URL=https://biome-app1.onrender.com
EXPO_PUBLIC_BACKEND_URL=https://biome-app1.onrender.com
