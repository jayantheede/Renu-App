# Renu Biome Environment Variables

# ==========================================
# MOBILE APP (.env)
# Copy this to mobile/.env
# ==========================================
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SHOPIFY_STOREFRONT_DOMAIN=renu-biome.myshopify.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# ==========================================
# BACKEND SERVER (.env)
# Copy this to backend/.env
# ==========================================
PORT=3000
DATABASE_URL="mongodb+srv://<username>:<password>@renubiome.xeghcoq.mongodb.net/renubiome?appName=renubiome"
SHOPIFY_ADMIN_API_ACCESS_TOKEN=your_admin_access_token_here
SHOPIFY_SHOP_DOMAIN=renu-biome.myshopify.com
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
